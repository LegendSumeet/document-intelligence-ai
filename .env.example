AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_PRIMARY_MODEL=your-index-deployment
AZURE_OPENAI_CHAT_MODEL=your-chat-deployment
AZURE_OPENAI_API_VERSION=your-api-version
DOCUMENT_INTELLIGENCE_API_KEY=replace-with-a-long-random-value
DOCUMENT_INTELLIGENCE_CORS_ORIGINS=http://localhost:8080

# Optional tuning (defaults shown)
# AZURE_OPENAI_TIMEOUT_SECONDS=120
# AZURE_OPENAI_MAX_RETRIES=3
